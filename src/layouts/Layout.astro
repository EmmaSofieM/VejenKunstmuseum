---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/generel.css';

interface Props {
  title?: string;
}

const { title = 'Vejen Kunstmuseum' } = Astro.props;
---

<!doctype html>
<html lang="da">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
	<link rel="apple-touch-icon" sizes="180x180" href="/favicon_io (2)/apple-touch-icon.png">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon_io (2)/favicon-32x32.png">
<link rel="icon" type="image/png" sizes="16x16" href="/favicon_io (2)/favicon-16x16.png">
<link rel="manifest" href="/favicon_io (2)/site.webmanifest">
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main>
			<slot />
		</main>
		<Footer />
		<script>
  import "../scripts/lenis.js";
</script>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		padding: 0;
		width: 100%;
		min-height: 100vh;
	}
	
	main {
		min-height: 60vh;
	}
	
	img {
		max-width: 100%;
		height: auto;
	}
</style>
