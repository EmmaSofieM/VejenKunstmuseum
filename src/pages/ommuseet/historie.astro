import Tidslinje from '../../components/Tidslinje.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';

---


<Layout>
    <h1>Historien</h1>
   <Breadcrumbs
      items={[
        { label: "Om museet", href: "/ommuseet/om" },
        { label: "Vision", href: "/ommuseet/vision"  },
        { label: "Samling", href: "/ommuseet/samling" },
     { label: "Historie", href: "/ommuseet/historie", active: true }

      ]}
    />
  <Tidslinje />
</Layout>

<style>
    h1 {
        font-family: var(--font-heading);
        margin-top: 150px;
        margin-left: 40px;
    }
</style>