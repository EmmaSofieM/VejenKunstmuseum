<script>
const now = new Date();
const day = now.getDay();
const hour = now.getHours();

const text = document.getElementById("status-text");
const dot = document.getElementById("status-dot");

let isOpen = false;

if (day === 1) {
  isOpen = false;
} else if (day >= 2 && day <= 5) {
  isOpen = hour >= 10 && hour < 16;
} else {
  isOpen = hour >= 11 && hour < 17;
}

text.textContent = isOpen ? "Åbent" : "Lukket";
dot.style.background = isOpen ? "#009C4C" : "#F73E36";

document.querySelectorAll(".dropdown").forEach((dropdown) => {
  const links = dropdown.querySelectorAll(".dropdown__left a");
  const box = dropdown.querySelector(".dropdown__right");
  const title = dropdown.querySelector(".dropdown__right h2");

  links.forEach((link, index) => {
    if (index === 0) {
      link.classList.add("is-active");
      box.style.setProperty("--dropdown-color", link.dataset.color);
      title.textContent = link.dataset.title || link.textContent;
    }

    const activateLink = () => {
      links.forEach((item) => item.classList.remove("is-active"));
      link.classList.add("is-active");
      title.textContent = link.dataset.title || link.textContent;
      box.style.setProperty("--dropdown-color", link.dataset.color || "#D9FF72");
    };

    link.addEventListener("mouseenter", activateLink);
    link.addEventListener("focus", activateLink);
  });
});

const mobileButton = document.querySelector(".mobile-menu-button");
const mobileTabs = document.querySelectorAll(".mobile-menu__tabs button");
const mobilePanels = document.querySelectorAll(".mobile-menu__links");
const mobilePreview = document.querySelector(".mobile-menu__preview");
const mobilePreviewTitle = document.querySelector(".mobile-menu__preview h2");

mobileButton.addEventListener("click", () => {
  document.body.classList.toggle("menu-open");
  mobileButton.classList.toggle("is-open");
});

mobileTabs.forEach((tab) => {
  tab.addEventListener("mouseenter", () => activateMobileTab(tab));
  tab.addEventListener("focus", () => activateMobileTab(tab));
  tab.addEventListener("click", () => activateMobileTab(tab));
});

function activateMobileTab(tab) {
  const target = tab.dataset.menu;

  mobileTabs.forEach((item) => item.classList.remove("is-active"));
  tab.classList.add("is-active");

  mobilePanels.forEach((panel) => {
    panel.classList.toggle("is-active", panel.dataset.menuPanel === target);
  });

  const activePanel = document.querySelector(`.mobile-menu__links[data-menu-panel="${target}"]`);
  const firstLink = activePanel.querySelector("a");

  activateMobileLink(firstLink, activePanel);
}

document.querySelectorAll(".mobile-menu__links a").forEach((link) => {
  link.addEventListener("mouseenter", () => activateMobileLink(link));
  link.addEventListener("focus", () => activateMobileLink(link));
});

function activateMobileLink(link, panel = link.closest(".mobile-menu__links")) {
  panel.querySelectorAll("a").forEach((item) => item.classList.remove("is-active"));

  link.classList.add("is-active");
  mobilePreviewTitle.textContent = link.dataset.title || link.textContent;
  mobilePreview.style.background = link.dataset.color || "#D9FF72";
}

// SEARCH
const searchButtons = document.querySelectorAll(".nav-search");
const searchInput = document.getElementById("site-search");
const searchResults = document.getElementById("search-results");

let searchData = [];

searchButtons.forEach((button) => {
  button.addEventListener("click", async () => {
    document.body.classList.toggle("search-open");

    if (document.body.classList.contains("search-open")) {
      document.body.classList.remove("menu-open");

      if (!searchData.length) {
        const response = await fetch("/search.json");
        searchData = await response.json();
      }

      setTimeout(() => searchInput.focus(), 50);
    }
  });
});

searchInput.addEventListener("input", () => {
  const query = searchInput.value.trim().toLowerCase();

  if (!query) {
    searchResults.innerHTML = "";
    return;
  }

  const results = searchData.filter((item) => {
    return (
      item.title.toLowerCase().includes(query) ||
      item.text.toLowerCase().includes(query)
    );
  });

  searchResults.innerHTML = results.length
    ? results
        .map(
          (item) => `
          <a href="${item.url}">
            ${item.title}
          </a>
        `
        )
        .join("")
    : `<p>Ingen resultater fundet.</p>`;
});

document.addEventListener("keydown", (event) => {
  if (event.key === "Escape") {
    document.body.classList.remove("search-open");
  }
});
const searchClose = document.querySelector(".search-close");

searchClose.addEventListener("click", () => {
  document.body.classList.remove("search-open");
});
</script>

