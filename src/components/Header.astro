<script>
const now = new Date();
const day = now.getDay();
const hour = now.getHours();

const text = document.getElementById("status-text");
const dot = document.getElementById("status-dot");

let isOpen = false;

if (day === 1) {
  isOpen = false;
} else if (day >= 2 && day <= 5) {
  isOpen = hour >= 10 && hour < 16;
} else {
  isOpen = hour >= 11 && hour < 17;
}

text.textContent = isOpen ? "Åbent" : "Lukket";
dot.style.background = isOpen ? "#009C4C" : "#F73E36";

document.querySelectorAll(".dropdown").forEach((dropdown) => {
  const links = dropdown.querySelectorAll(".dropdown__left a");
  const box = dropdown.querySelector(".dropdown__right");
  const title = dropdown.querySelector(".dropdown__right h2");

  links.forEach((link, index) => {
    if (index === 0) {
      link.classList.add("is-active");
      box.style.setProperty("--dropdown-color", link.dataset.color);
      title.textContent = link.dataset.title || link.textContent;
    }

    const activateLink = () => {
      links.forEach((item) => item.classList.remove("is-active"));
      link.classList.add("is-active");
      title.textContent = link.dataset.title || link.textContent;
      box.style.setProperty("--dropdown-color", link.dataset.color || "#D9FF72");
    };

    link.addEventListener("mouseenter", activateLink);
    link.addEventListener("focus", activateLink);
  });
});

const mobileButton = document.querySelector(".mobile-menu-button");
const mobileMenu = document.querySelector(".mobile-menu");
const mobileLinks = document.querySelectorAll(".mobile-menu__links a");
const mobilePreview = document.querySelector(".mobile-menu__preview");
const mobilePreviewTitle = document.querySelector(".mobile-menu__preview h2");

mobileButton.addEventListener("click", () => {
  document.body.classList.toggle("menu-open");
  mobileButton.classList.toggle("is-open");
});

mobileLinks.forEach((link) => {
  link.addEventListener("mouseenter", () => activateMobileLink(link));
  link.addEventListener("focus", () => activateMobileLink(link));
});

function activateMobileLink(link) {
  mobileLinks.forEach((item) => item.classList.remove("is-active"));
  link.classList.add("is-active");
  mobilePreviewTitle.textContent = link.dataset.title || link.textContent;
  mobilePreview.style.background = link.dataset.color || "#D9FF72";
}
</script>

<style>
