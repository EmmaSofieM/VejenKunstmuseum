  border: 0;
  background: transparent;
  padding: 0;
  margin-top: -4px;
  color: inherit;
  cursor: pointer;
  line-height: 0;
}

.header__mobile-actions,
.mobile-menu {
  display: none;
}

/* MOBIL */
@media (max-width: 900px) {
