---
// filepath: src/components/Footer.astro
---
<footer class="footer">
  <div class="footer-left">
    <div class="footer-top">
      <div class="footer-col">
        <div class="footer-title">MUSEET</div>
        <a href="/udstillinger/aktuelle">Udstillinger</a>
        <a href="/kalender">Kalender</a>
        <a href="/ommuseet/om">Museet</a>
      </div>

      <div class="footer-col">
        <div class="footer-title">PRAKTISK</div>
        <a href="/besoeg/aabningstider">Åbningstider</a>
        <a href="/besoeg/praktiskinfo">Hjælp</a>
        <a href="/besoeg/findvej">Find vej</a>
      </div>
      <div class="footer-col">
        <div class="footer-title">LEGAL</div>
        <a href="https://www.vejenkunstmuseum.dk/" target="_blank">Privatlivspolitik</a>
        <a href="/besoeg/billedskolen">Undervisning</a>
        <a href="https://www.vejenkunstmuseum.dk/" target="_blank">Presseomtale</a>
      </div>
    </div>
    <div class="footer-contact">
      <div class="footer-title">KONTAKT</div>
      <div>Vejens Kunstmuseum</div>
      <div>Museumsdirektør, Teresa Nielsen</div>
      <div><a href="https://www.google.com/maps/place/Østergade+4,+6600+Vejen,+Danmark" target="_blank">6600 Vejen Østergade 4</a></div>
      <div><a href="mailto:museum@vejen.dk">museum@vejen.dk</a></div>
      <div>For presse <a href="mailto:karwi@vejen.dk">karwi@vejen.dk</a></div>
      <div><a href="tel:+4579966942">+45 79 96 69 42</a></div>
      <div class="footer-small">(hverdage 10-16)</div>
      <div class="insta"><a href="https://www.instagram.com/vejenkunstmuseum/" target="_blank"><img src="/ikoner/insta.svg" alt="insta"></a></div>

    </div>
  </div>
  <div class="footer-right">
    <div class="footer-newsletter">
      <div class="footer-title">ABONNER PÅ VORES NYHEDSBREV</div>
      <form class="newsletter">
        <label for="newsletter-email"></label>
        <div class="newsletter-input">
          <input type="email" id="newsletter-email" name="email" placeholder="Email" required />
<button type="submit" aria-label="Tilmeld">›</button>
        </div>
        <div class="newsletter-check">
          <input type="checkbox" id="accept-privacy" required />
          <label for="accept-privacy">Jeg accepterer <a href="/ommuseet/om">privatlivspolitikken</a>.</label>
        </div>
      </form>
    </div>
        <div class="footer-trold"> <img src="/logo/trold.svg" alt="trold"> </div>

    <div class="footer-brand"> <img src="/logo/logorød.svg" alt="logo"> </div>
    </div>
  </div>
</footer>

<style>

  .newsletter.is-sent .newsletter-input input {
  opacity: 1;
  cursor: default;
}

.newsletter.is-sent .newsletter-input button {
  opacity: 1;
  transform: none;
  cursor: default;
}
  .newsletter-input input {
  flex: 1;
  border: none;
  background: transparent;
  padding: 6px 0;
  font-size: 14px;
  outline: none;
  color: #1A1A1A;
}

.newsletter-input input::placeholder {
  color: #1A1A1A;
  opacity: 1;
}
.footer {
  display: grid;
  grid-template-columns: 2fr 1fr;
  min-height: 400px;
}
.footer-left {
  background: #E0E1E3;
  padding: 32px 0 0 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.footer-top {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 80px;
}
.footer-col a {
  transition: color 0.3s ease, opacity 0.3s ease, transform 0.3s ease;
}

.footer-col a:hover {
  opacity: 0.7;
  transform: translateX(3px);
}

.footer-col {
  display: flex;
  flex-direction: column;
  gap: 8px;
  font-size: 14px;
}
.footer-title {
  font-size: 14px;
  font-weight: light;
  margin-bottom: 12px;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}
.footer-contact a {
  transition: color 0.3s ease, opacity 0.3s ease;
}

.footer-contact a:hover {
  opacity: 0.7;
}

.footer-contact {
  margin-top: 40px;
  max-width: 320px;
  font-size: 14px;
  line-height: 1.6;
}
.footer-small {
  font-size: 14px;
}
.footer-right {
  background: #FF6443;
  color: #1A1A1A;
  padding: 16px 16px 40px 20px;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  position: relative;
  overflow: hidden;
}
.footer-newsletter {
  margin-bottom: 32px;
}
.newsletter {
  margin-top: 20px;
}
.newsletter label {
  font-size: 12px;
}
.newsletter-input {
  display: flex;
  border-bottom: 1px solid #1A1A1A;
  margin-top: 6px;
}
.newsletter-input input {
  flex: 1;
  border: none;
  background: transparent;
  padding: 6px 0;
  font-size: 14px;
  outline: none;
  color: #1A1A1A;
  transition: opacity 0.3s ease;
}

.newsletter-input input:focus {
  opacity: 0.8;
}
.newsletter-input button {
  border: none;
  background: transparent;
  font-size: 20px;
  cursor: pointer;
  color: #1A1A1A;
  padding: 0 8px;
  transition: opacity 0.3s ease, transform 0.3s ease;
}

.newsletter-input button:hover {
  opacity: 0.7;
  transform: scale(1.15);
}

.newsletter-input button:active {
  transform: scale(0.95);
}
.newsletter-check {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-top: 8px;
  font-size: 12px;

}
.newsletter-check a {
  color: #1A1A1A;
  text-decoration: underline;
}
.footer-brand {
  position: absolute;
  bottom: -10px;
  right: 20px;
  z-index: 1;
}
.footer-brand img {
  width: 450px;  
  height: auto;
}

.footer-trold {
  position: absolute;
  bottom: 110px;
  right: 20px;
  z-index: 1;
}
.footer-trold img {
  width: 150px;  
  height: auto;
}
.insta {
  bottom: 16px;
  left: 16px;
padding-top: 20px;}

@media (max-width: 1200px) {
  .footer-brand {
    font-size: 40px;
    right: 20px;
  }
}
@media (max-width: 900px) {
  .footer {
    grid-template-columns: 1fr;
  }
  .footer-left {
    padding: 24px 16px 0 16px;
  }
  .footer-top {
    grid-template-columns: 1fr;
    gap: 40px;
  }
  .footer-brand {
    font-size: 24px;
    right: 8px;
    bottom: 8px;
  }
  .footer-right {
    padding: 24px 16px 0 16px;
  }
  
}
@media (max-width: 900px) {
  .footer {
    display: flex;
    flex-direction: column-reverse;
    min-height: auto;
  }

  .footer-right {
    min-height: 360px;
    padding: 36px 8px 32px;
  }

  .footer-newsletter {
    margin-bottom: 0;
  }

  .footer-title {
    font-size: 14px;
    margin-bottom: 58px;
  }

  .newsletter {
    margin-top: 0;
  }

  .newsletter-input {
    margin-top: 0;
    border-bottom: 1px solid #1A1A1A;
  }

  .newsletter-input input {
    font-size: 14px;
    padding: 10px 0;
  }

  .newsletter-input button {
    font-size: 24px;
    line-height: 0.8;
    padding: 0 18px;
  }

  .newsletter-check {
    margin-top: 12px;
    gap: 10px;
    font-size: 14px;
  }

  .newsletter-check input {
    width: 15px;
    height: 15px;
    appearance: none;
    border: 1px solid #1A1A1A;
    background: transparent;
    margin: 0;
  }

  .newsletter-check input:checked {
    background: #1A1A1A;
  }

  .footer-left {
    min-height: 500px;
    padding: 32px 16px 0;
    background: #E0E1E3;
    position: relative;
    overflow: hidden;
  }

  .footer-top {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }

  .footer-col {
    font-size: 14px;
    gap: 8px;
  }

  .footer-col .footer-title {
    font-size: 14px;
    margin-bottom: 4px;
  }

  .footer-contact {
    margin-top: 4px;
    max-width: none;
    font-size: 14px;
    line-height: 1.35;
  }

  .footer-contact .footer-title {
    font-size: 14px;
    margin-bottom: 14px;
  }

  .footer-small {
    margin-top: 42px;
    font-size: 14px;
  }

  

  .footer-trold {
    bottom: -50px;
    right: -10px;
  }

  .footer-trold img {
    width: 165px;
  }

  .footer-brand {
    left: 0;
    right: auto;
    bottom: -8px;
  }

  .footer-brand img {
    width: 510px;
    max-width: none;
  }
}
</style>

<script>
const newsletterForm = document.querySelector(".newsletter");
const newsletterInput = document.querySelector("#newsletter-email");
const newsletterButton = document.querySelector(".newsletter-input button");

newsletterForm.addEventListener("submit", (event) => {
  event.preventDefault();

  newsletterInput.value = "Sendt";
  newsletterInput.disabled = true;

newsletterButton.innerHTML = "⌝";  newsletterButton.setAttribute("aria-label", "Tilmeldt nyhedsbrev");
  newsletterButton.disabled = true;

  newsletterForm.classList.add("is-sent");
});
</script>