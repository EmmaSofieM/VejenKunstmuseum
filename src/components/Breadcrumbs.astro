---
const { items = [] } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Breadcrumb">
  {items.map((item, index) =>
    item.active ? (
      <span class="crumb is-active" aria-current="page">
        {item.label}
      </span>
    ) : (
      <a href={item.href} class="crumb">
        {item.label}
      </a>
    )
  )}
</nav>

<style>
.breadcrumbs {
  display: flex;
  align-items: center;
  gap: 6px;
  margin-left: 40px;
  margin-bottom: 40px;

  font-size: 12px;
  text-transform: uppercase;

  overflow-x: auto;
  white-space: nowrap;
  -webkit-overflow-scrolling: touch;
  scrollbar-width: none;
}

.breadcrumbs::-webkit-scrollbar {
  display: none;
}

.crumb {
  color: #1A1A1A;
  text-decoration: none;
  font-weight: 400;
  position: relative;
  flex: 0 0 auto;
  transition: opacity 0.15s ease;
}

.crumb:not(:last-child)::after {
  content: "›";
  margin-left: 6px;
  opacity: 0.45;
}

.crumb:hover {
  opacity: 0.6;
}

.crumb.is-active {
  font-weight: 600;
}

.crumb.is-active::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -3px;
  width: 100%;
  height: 1px;
  background: currentColor;
}

@media (max-width: 600px) {
  .breadcrumbs {
    margin-left: 16px;
    margin-right: 16px;
    margin-bottom: 24px;
    font-size: 11px;
  }
}
</style>