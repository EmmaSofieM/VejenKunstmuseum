---
const { items = [] } = Astro.props;
---

<nav class="breadcrumbs" aria-label="Brødkrummesti">
  <ol class="breadcrumbs__list">
    {items.map((item) => (
      <li class="breadcrumbs__item">
        {item.active ? (
          <span class="breadcrumbs__current" aria-current="page">
            {item.label}
          </span>
        ) : (
          <a href={item.href} class="breadcrumbs__link">
            {item.label}
          </a>
        )}
      </li>
    ))}
  </ol>
</nav>

<style>
.breadcrumbs {
  margin: 0 40px 40px;
  font-family: var(--font-body);
}

.breadcrumbs__list {
  display: flex;
  align-items: center;
  gap: 0;
  margin: 0;
  padding: 0;
  list-style: none;

  overflow-x: auto;
  white-space: nowrap;
  scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}

.breadcrumbs__list::-webkit-scrollbar {
  display: none;
}

.breadcrumbs__item {
  display: flex;
  align-items: center;
  flex: 0 0 auto;
  color: #1a1a1a;
}

.breadcrumbs__item:not(:last-child)::after {
  content: "/";
  margin: 0 10px;
  font-size: 12px;
  color: #1a1a1a;
  opacity: 0.4;
}

.breadcrumbs__link,
.breadcrumbs__current {
  font-size: 13px;
  line-height: 1;
  text-transform: uppercase;
  letter-spacing: 0.02em;
}

.breadcrumbs__link {
  color: #1a1a1a;
  text-decoration: none;
  opacity: 0.65;
  transition:
    opacity 180ms ease,
    text-decoration-color 180ms ease;
}

.breadcrumbs__link:hover,
.breadcrumbs__link:focus-visible {
  opacity: 1;
  text-decoration: underline;
  text-underline-offset: 4px;
}

.breadcrumbs__current {
  color: #1a1a1a;
  font-weight: 600;
  opacity: 1;
}

@media (max-width: 600px) {
  .breadcrumbs {
    margin: 0 20px 28px;
  }

  .breadcrumbs__item:not(:last-child)::after {
    margin: 0 8px;
  }

  .breadcrumbs__link,
  .breadcrumbs__current {
    font-size: 11px;
  }
}
</style>