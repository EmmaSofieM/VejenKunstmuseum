<style>
.collection {
  margin: 0 40px 80px;
  color: #1A1A1A;
  font-family: var(--font-body);
}

/* FILTER — samme princip som kalender */

.calendar-event__chevron {
  justify-self: end;
  transition: transform 180ms ease;
}
.calendar-event__chevronned {
   transform: rotate(90deg);

}
.calendar-event.is-open .calendar-event__chevron {
  transform: rotate(90deg);
}
.collection__filter {
  position: relative;
  width: 100%;
  margin-bottom: 18px;
}

.collection__filter-button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 0 0 8px;
  border: 0;
  background: transparent;
  color: inherit;
  font-size: 14px;
  text-transform: uppercase;
  cursor: pointer;
}

.collection__filter-icon {
  display: inline-flex;
  align-items: center;
  transform: rotate(90deg);
}

.collection__filter-icon img {
  width: 16px;
  height: auto;
  display: block;
}

.collection__filter-menu {
  position: absolute;
  top: 100%;
  left: 0;
  display: none;
  min-width: 180px;
  padding: 14px;
  background: #fff;
  border: 1px solid #1A1A1A;
  z-index: 30;
}

.collection__filter.is-open .collection__filter-menu {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.collection__filter-menu button {
  border: 0;
  background: transparent;
  padding: 6px 0;
  color: inherit;
  cursor: pointer;
  font-size: 14px;
}

.collection__filter-menu button:hover,
.collection__filter-menu button.is-active {
  text-decoration: underline;
}

/* GRID */
.collection__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 8px;
}

/* CARD */
.collection-card {
  background: #DFFF8C;
  min-width: 0;
}

.collection-card img {
  width: 100%;
  aspect-ratio: 1 / 0.72;
  object-fit: cover;
  display: block;
}

.collection-card__content {
  min-height: 145px;
  padding: 10px 12px 12px;
  display: flex;
  flex-direction: column;
}

.collection-card__artist {
  margin: 0 0 5px;
  font-size: 10px;
  line-height: 1.15;
  text-transform: uppercase;
}

.collection-card h3 {
  margin: 0;
  font-size: 14px;
  line-height: 1.15;
  font-weight: 400;
}

.collection-card__meta {
  margin-top: auto;
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 16px;
  font-size: 12px;
  line-height: 1.15;
}

.collection-card.is-hidden {
  display: none;
}

@media (max-width: 900px) {
  .collection {
    margin: 0 20px 60px;
  }

  .collection__grid {
    grid-template-columns: 1fr;
  }

  .collection-card__content {
    min-height: 130px;
  }
}
</style>

<script>
const collectionFilter = document.querySelector(".collection__filter");
const collectionFilterButton = document.querySelector(".collection__filter-button");
const collectionFilterOptions = document.querySelectorAll(".collection__filter-menu button");
const collectionCards = document.querySelectorAll(".collection-card");

collectionFilterButton.addEventListener("click", () => {
  collectionFilter.classList.toggle("is-open");
});

collectionFilterOptions.forEach((button) => {
  button.addEventListener("click", () => {
    const selected = button.dataset.filter;

    collectionFilterOptions.forEach((item) => item.classList.remove("is-active"));
    button.classList.add("is-active");

    collectionCards.forEach((card) => {
      const categories = card.dataset.category.split(', ').map(cat => cat.trim());
      const match = selected === "all" || categories.includes(selected);
      card.classList.toggle("is-hidden", !match);
    });

    collectionFilter.classList.remove("is-open");
  });
});

document.addEventListener("click", (event) => {
  if (!collectionFilter.contains(event.target)) {
    collectionFilter.classList.remove("is-open");
  }
});
</script>